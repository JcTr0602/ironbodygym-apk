<?xml version="1.0" encoding="utf-8"?>
<!-- Splash 1.20 (V9): fondo carbón de marca y logo centrado, sin
     texto pequeño ni efectos. El fondo coincide con el del icono
     adaptativo (#1A1A1A) para que el paso icono → splash → app no
     parpadee de color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
